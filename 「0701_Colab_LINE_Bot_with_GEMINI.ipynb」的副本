set_auth_token(ngrok_authtoken)\n","tunnel = ngrok.connect(5051, name=\"linebot_tunnel\")\n","webhook_url = tunnel.public_url\n","\n","print(f\"Ngrok URL: {webhook_url}\")\n","\n","# 自動更新 LINE Webhook URL\n","def update_line_webhook(webhook_url):\n","    \"\"\"使用 LINE Messaging API 更新 Webhook URL\"\"\"\n","    url = \"https://api.line.me/v2/bot/channel/webhook/endpoint\"\n","    headers = {\n","        \"Authorization\": f\"Bearer {line_channel_access_token}\",\n","        \"Content-Type\": \"application/json\"\n","    }\n","    data = {\n","        \"endpoint\": webhook_url\n","    }\n","\n","    response = requests.put(url, headers=headers, json=data)\n","\n","    if response.status_code == 200:\n","        print(f\"✅ LINE Webhook URL 已自動更新為：{webhook_url}\")\n","        return True\n","    else:\n","        print(f\"❌ 更新失敗：{response.status_code} - {response.text}\")\n","        return False\n","\n","# 執行更新\n","update_line_webhook(webhook_url)"]},{"cell_type":"code","execution_count":7,"metadata":{"id":"3uztGuOtjbSY","executionInfo":{"status":"ok","timestamp":1779417794360,"user_tz":-480,"elapsed":24636,"user":{"displayName":"","userId":""}},"outputId":"127a3105-5a5f-4d11-f4ec-5b22797d1cb0","colab":{"base_uri":"https://localhost:8080/"}},"outputs":[{"output_type":"stream","name":"stdout","text":["AI Agent (人工智能代理) 是一種**能夠感知環境、進行決策、並執行動作以達成特定目標的智能系統**。它比傳統的自動化程式更為**自主**、**具備推理能力**，並且能夠**適應複雜的環境變化**。\n","\n","簡而言之，你可以將 AI Agent 理解為一個**虛擬的「智慧機器人」**，它不只會按照指令行事，還會「思考」、規劃、使用工具，並根據環境反饋來調整自己的行為，以更好地完成任務。\n","\n","### AI Agent 的核心構成與運作循環：\n","\n","一個典型的 AI Agent 運作會遵循以下循環 (P-E-A-R 循環)：\n","\n","1.  **感知 (Perception)：** 接收來自環境的訊息。這可以是文字、圖片、數據、API 回應，甚至是使用者指令。\n","2.  **思考/決策 (Thinking/Reasoning)：** 根據感知到的資訊、內部的知識和規則、以及設定的目標，進行分析、規劃、推理，並決定下一步的行動。現代的 AI Agent 常用大型語言模型 (LLM) 作為其「大腦」來進行這一步。\n","3.  **執行動作 (Action)：** 根據決策執行一個或多個動作。這可能包括生成文字、呼叫外部工具 (如搜尋引擎、資料庫、API)、發送郵件、執行程式碼等。\n","4.  **環境 (Environment)：** Agent 所在的操作空間，其行為會對環境產生影響，環境的變化又會被 Agent 感知。\n","\n","這個循環會持續進行，直到目標達成或遇到無法解決的問題。\n","\n","### AI Agent 的主要特點：\n","\n","*   **自主性 (Autonomy)：** 能夠在無需人類持續介入的情況下獨立運作和做出決策。\n","*   **目標導向 (Goal-oriented)：** 所有的行為都圍繞著實現一個或多個預設目標。\n","*   **環境感知 (Environmental Perception)：** 能夠從周圍環境獲取和解讀資訊。\n","*   **靈活性與適應性 (Flexibility & Adaptability)：** 能夠根據環境變化和新資訊調整策略和行為。\n","*   **工具使用 (Tool Usage)：** 許多現代 AI Agent 能夠整合並使用各種外部工具 (如網頁瀏覽器、計算機、API、程式碼解釋器等)，擴展其能力。\n","*   **記憶與學習 (Memory & Learning)：** 能夠儲存過去的經驗和資訊 (短期記憶如對話上下文，長期記憶如知識庫)，並從中學習以提升未來表現。\n","\n","### 現代 AI Agent (基於 LLM) 的組成部分：\n","\n","特別是結合了大型語言模型 (LLM) 後，AI Agent 的能力得到了飛躍式的提升。一個基於 LLM 的 AI Agent 通常包含以下關鍵組件：\n","\n","1.  **核心大腦 (Core Brain)：** 通常是一個強大的 LLM，負責理解指令、推理、規劃、決策和生成自然語言。\n","2.  **記憶 (Memory)：**\n","    *   **短期記憶 (Short-term Memory/Context Window)：** 儲存當前任務或對話的上下文資訊。\n","    *   **長期記憶 (Long-term Memory/Knowledge Base)：** 儲存歷史經驗、學到的知識、使用者偏好等，可以透過向量資料庫或傳統資料庫實現。\n","3.  **規劃器/推理引擎 (Planner/Reasoning Engine)：** 讓 LLM 能夠將一個複雜的目標分解成一系列可執行的子任務，並制定達成目標的策略 (例如 ReAct 模式)。\n","4.  **工具庫 (Tool Library)：** 一組定義好的功能或 API，讓 Agent 能夠執行超出 LLM 本身文本生成能力之外的操作，例如：\n","    *   網頁搜尋 (Google Search API)\n","    *   程式碼執行 (Python interpreter)\n","    *   資料庫查詢\n","    *   發送郵件/訊息\n","    *   與其他系統互動 (CRM, ERP 等)\n","5.  **感知器/執行器 (Sensors/Actuators)：** 用於與實際環境互動的介面，例如接收使用者輸入、將動作輸出到外部系統。\n","\n","### 如何運作的簡單範例：\n","\n","假設你給一個 AI Agent 下達指令：**「幫我規劃一次從台北到台中的三天兩夜輕旅行，包含交通、住宿推薦及景點，預算大約一萬元，並找出當地特色美食。」**\n","\n","1.  **感知：** Agent 接收到你的指令。\n","2.  **思考/規劃：**\n","    *   LLM 大腦理解目標是「規劃旅行」。\n","    *   將大目標分解為子任務：1. 查詢交通 2. 搜尋住宿 3. 規劃景點 4. 尋找美食 5. 整合預算。\n","    *   確定需要使用的工具：網頁搜尋、地圖服務、訂房網站 API、評論網站等。\n","3.  **執行動作 (疊代過程)：**\n","    *   **動作 1：** 使用網頁搜尋工具查詢「台北到台中交通方式」，獲取火車、高鐵、客運資訊。\n","    *   **感知：** 獲得交通選項。\n","    *   **思考：** 分析交通時間與成本。\n","    *   **動作 2：** 使用訂房網站 API 搜尋「台中三天兩夜住宿推薦，價格區間」，篩選符合預算的選項。\n","    *   **感知：** 獲得住宿列表。\n","    *   **思考：** 結合住宿地點，規劃周邊景點。\n","    *   **動作 3：** 使用地圖服務和網頁搜尋查詢「台中特色美食」。\n","    *   **感知：** 獲得美食清單。\n","    *   **思考：** 將所有資訊整合，考慮時間安排和預算限制，生成詳細行程。\n","4.  **最終報告：** Agent 將整理好的三天兩夜行程 (包含交通方式、推薦住宿、每日景點規劃、特色美食列表及預算估計) 呈現給你。\n","\n","### AI Agent 的應用：\n","\n","*   **個人助理：** 比Siri/Alexa更聰明，能主動安排行程、管理郵件、回答複雜問題。\n","*   **自動化客服：** 不僅回答問題，還能主動解決問題，如處理訂單、退款、技術支援。\n","*   **數據分析與報告：** 自動從各種數據源收集、分析資訊，並生成專業報告。\n","*   **軟體開發助理：** 協助編寫程式碼、測試、除錯、甚至自動部署。\n","*   **智能家居系統：** 更智能地管理家庭設備，預測需求並自動調整。\n","*   **研究助理：** 自動化地從網路和資料庫中收集資料、歸納總結。\n","\n","總之，AI Agent 代表著人工智能發展的一個重要方向，它讓 AI 從被動響應指令轉變為具備主動性、規劃能力和工具使用能力，能夠在更廣泛、更複雜的現實世界任務中發揮作用。\n"]}],"source":["from google import genai\n","\n","client = genai.Client(api_key=gemini_api_key)\n","\n","response = client.models.generate_content(\n","    model=\"gemini-2.5-flash\",\n","    contents=\"什麼是AI AGENT？\"\n",")\n","print(response.text)"]},{"cell_type":"code","execution_count":8,"metadata":{"id":"RnoLAbWujbSY","executionInfo":{"status":"ok","timestamp":1779417829302,"user_tz":-480,"elapsed":12,"user":{"displayName":"","userId":""}}},"outputs":[],"source":["def stateless_query(payload):\n","    response = client.models.generate_content(\n","        model=\"gemini-2.5-flash\",\n","        contents=payload\n","    )\n","    return response.text\n"]},{"cell_type":"code","execution_count":9,"metadata":{"id":"f-oeubJyMjEW","executionInfo":{"status":"ok","timestamp":1779417843815,"user_tz":-480,"elapsed":12458,"user":{"displayName":"","userId":""}},"outputId":"01308631-4bd9-4721-de45-6490b1590f36","colab":{"base_uri":"https://localhost:8080/"}},"outputs":[{"output_type":"stream","name":"stdout","text":["明新科技大學 (Ming Hsin University of Science and Technology，簡稱明新科大) 是一所位於台灣新竹縣的私立科技大學。學校以其歷史悠久、實務導向的教學及與產業緊密的連結而聞名。\n","\n","**以下是明新科技大學的簡要介紹：**\n","\n","1.  **創校與發展：**\n","    *   **創校年份：** 1966年，前身為「明新工業專科學校」。\n","    *   **改制為大學：** 2002年，升格並改名為「明新科技大學」。\n","    *   **辦學理念：** 秉持「明德、新民」的校訓精神，致力於培養具備專業技能、實務能力及人文素養的產業人才。\n","\n","2.  **地理位置優勢：**\n","    *   學校座落於新竹縣新豐鄉，地理位置優越，緊鄰新竹科學園區、湖口工業區等高科技與工業重鎮。\n","    *   這使得明新科大在產學合作、學生實習與畢業就業方面，擁有得天獨厚的連結與資源。\n","\n","3.  **學院與系所：**\n","    *   學校設有工學院、管理學院、服務事業學院及設計學院等四大教學單位，提供學士、碩士等多層次學位課程。\n","    *   **工學院：** 強調工程技術與實作能力，與周邊科技產業緊密結合。\n","    *   **管理學院：** 培育企業管理、資訊管理等相關人才。\n","    *   **服務事業學院：** 順應服務業發展趨勢，培養觀光、休閒、餐旅等領域的專業人才。\n","    *   **設計學院：** 注重創意發想與設計實務，涵蓋多媒體、空間設計等領域。\n","\n","4.  **教育特色：**\n","    *   **實務教學：** 課程設計強調理論與實務並重，積極推動業師協同教學、校外實習、專題製作等，提升學生的實作能力和職場競爭力。\n","    *   **產學合作：** 與眾多企業建立合作關係，共同開發技術、提供研究資源與實習機會。\n","    *   **國際交流：** 推動國際交換學生、雙聯學位及海外實習等計畫，擴展學生的國際視野。\n","    *   **證照輔導：** 鼓勵學生考取專業證照，提升就業競爭力。\n","\n","5.  **整體評價：**\n","    明新科技大學是一所以科技、實務和產業連結為核心的應用型大學。它致力於為台灣的產業發展培育具備即戰力的專業人才，特別是在工程、管理和服務領域，因其地利之便和深耕產業的努力，畢業生在就業市場上具有一定的競爭力。\n"]}],"source":["result = stateless_query(\"簡介明新科技大學\")\n","print(result)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"jdG0_hVBMjEX","outputId":"dfc3d234-a608-41bb-82d0-439ab157cde2","colab":{"base_uri":"https://localhost:8080/"}},"outputs":[{"output_type":"stream","name":"stdout","text":[" * Serving Flask app '__main__'\n"," * Debug mode: off\n"]},{"output_type":"stream","name":"stderr","text":["INFO:werkzeug:\u001b[31m\u001b[1mWARNING: This is a development server. Do not use it in a production deployment. Use a production WSGI server instead.\u001b[0m\n"," * Running on http://127.0.0.1:5051\n","INFO:werkzeug:\u001b[33mPress CTRL+C to quit\u001b[0m\n"]},{"output_type":"stream","name":"stdout","text":["BODY:  {\"destination\":\"U932315c6a4f7d786bc81938790bab2ee\",\"events\":[{\"type\":\"message\",\"message\":{\"type\":\"text\",\"id\":\"615030279018381948\",\"quoteToken\":\"IZIlmepeFemtdSZ0ZISP6dECFlkKmTLhYEIizVie27HzXLo5sDvdukRW-NWeEUNL-Jy6CUke5jFLlbpA2QIjPmhdRiaSfgwtbbchDY8cAcTPTT7rQob4IDSPCHjE0088B9aHUojyWJC-sIRW5mmrSQ\",\"markAsReadToken\":\"24HJg5kjbY33iq6xFknHnRPWD_tPBwWrTebKS7LFTtLFdcckiDF0ZeuaFiZPX652uf1dHEGnqxJmuRBHYsYJ95qTjhNaJMj6gSMfVQCUSwvekYitj8UDFzOJhMdBkh1iKmppLD70bzVB-NLSkW4Obrm3Z2Db7IoZlAfJDjKeW0wbNZTogmjC2-1aVV1el4ayt9LWjWv5QoQs3HM1mMzVFg\",\"text\":\"AI 簡介明新科技大學\"},\"webhookEventId\":\"01KS6S5A2CZX9X7MZD7SHMMZ7F\",\"deliveryContext\":{\"isRedelivery\":false},\"ti